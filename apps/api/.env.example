# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://physio:physio@localhost:5434/physioconnect
TEST_DATABASE_URL=postgres://physio:physio@localhost:5434/physioconnect_test

# Long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_ACCESS_SECRET=change-me
OTP_SECRET=change-me

# SMS: "console" prints codes to the server log (development only); "msg91" sends real SMS.
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# The only way a super admin account is created: `npm run api:seed` with these set.
SUPER_ADMIN_PHONE=
SUPER_ADMIN_NAME=

# UPI that patients pay to (shown as a QR). Applied by `npm run api:seed`.
PAYMENT_UPI_ID=
PAYMENT_UPI_NAME=PhysioConnect

# File storage: local disk now (kept permanently). STORAGE_DIR defaults to apps/api/storage.
STORAGE_DRIVER=local
STORAGE_DIR=

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Public URLs (QR codes and share links). In production: https://api.<your-domain> and https://<your-domain>/
PUBLIC_API_URL=http://localhost:4000
SITE_URL=http://localhost:5173/
