# Copy to deploy/.env on the server. Never commit it.
# Point these DNS A records at your server's IP before the first start (HTTPS certificates are issued automatically).
SITE_DOMAIN=physiocare.example.in
ADMIN_DOMAIN=admin.physiocare.example.in
API_DOMAIN=api.physiocare.example.in
# Email for the HTTPS certificate authority (expiry notices).
ACME_EMAIL=you@example.in
# Database password: long and random (e.g. `openssl rand -hex 24`).
POSTGRES_PASSWORD=change-me
APP_VERSION=1.0.0
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=30
