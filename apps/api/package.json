{
  "name": "@physioconnect/api",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js up",
    "migrate:down": "node --env-file-if-exists=.env scripts/migrate.js down",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "vitest run",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed-demo.js"
  },
  "dependencies": {
    "@physioconnect/shared": "0.8.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.5",
    "umzug": "^3.8.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
