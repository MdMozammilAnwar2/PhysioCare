# PhysioCare API configuration. Copy to .env and edit. Never commit .env.
# Every value is optional unless marked REQUIRED; the default is shown. Restart the API after changing.
# Settings marked [console] are also editable in the admin console; .env only gives their starting value
# (applied by `npm run api:seed`). Set SETTINGS_FROM_ENV=overwrite and run the seed to force .env values.

# ============ Server ============
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://physio:physio@localhost:5434/physioconnect
TEST_DATABASE_URL=postgres://physio:physio@localhost:5434/physioconnect_test

# ============ Security (REQUIRED in production) ============
# Long random strings: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me
OTP_SECRET=change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# ============ Sign-in with OTP ============
# SMS_PROVIDER: "console" prints codes in this terminal (development); "msg91" sends real SMS (after DLT approval).
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_15_MIN=5
OTP_RESEND_AFTER_SECONDS=30

# ============ Super admin ============
# The ONLY way a super admin is created: `npm run api:seed` with this set. No API can create one.
SUPER_ADMIN_PHONE=
SUPER_ADMIN_NAME=

# ============ Payments ============
# UPI that patients pay to (shown as a QR). Applied by `npm run api:seed`. Empty = cash only.
PAYMENT_UPI_ID=
PAYMENT_UPI_NAME=PhysioCare

# ============ URLs ============
# Production: PUBLIC_API_URL=https://api.<your-domain>  SITE_URL=https://<your-domain>/
# Printed QR codes contain PUBLIC_API_URL: set it before printing any.
PUBLIC_API_URL=http://localhost:4000
SITE_URL=http://localhost:5173/
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ============ Files ============
# Local disk now (kept permanently). Empty STORAGE_DIR = apps/api/storage.
STORAGE_DRIVER=local
STORAGE_DIR=

# ============ Visits and safety ============
CHECKIN_MAX_ATTEMPTS=5
SLOT_STEP_MINUTES=15
# Drive-time estimate until Google Maps is connected.
TRAVEL_MINUTES_PER_KM=3
LOCATION_EVERY_SECONDS=60
# Home-visit hours per zone colour (IST), like 07:00-20:00, or "closed" for no new bookings.
ZONE_HOURS_GREEN=07:00-20:00
ZONE_HOURS_BLUE=08:00-19:00
ZONE_HOURS_YELLOW=07:00-20:00
ZONE_HOURS_ORANGE=08:00-18:00
ZONE_HOURS_RED=closed

# ============ Scheduling [console] ============
VISIT_MINUTES_HOME=45
VISIT_MINUTES_VIDEO=30
VISIT_MINUTES_CLINIC=40
TRAVEL_BUFFER_MINUTES=10
BOOKING_WINDOW_DAYS=60
MIN_NOTICE_HOURS=3
PAYMENT_HOLD_MINUTES=10
OFFER_HOLD_MINUTES=24
MIN_DAYS_BETWEEN_SESSIONS=1
MAX_VISITS_PER_DAY=8
FREE_RESCHEDULE_HOURS=3

# ============ Money [console] ============
# Confirm TDS with your CA before going live.
PLATFORM_FEE_PCT=0
TDS_PCT=0
EARNING_HOLD_DAYS=7
MIN_PAYOUT_RUPEES=500
REPORT_WINDOW_DAYS=7

# ============ Growth: coins and partners ============
COINS_PER_RUPEE=10
MAX_PARTNER_QR_CODES=50
# More sign-ups than this from one device in 24 h are flagged (no coins, no rewards).
SAME_DEVICE_SIGNUP_LIMIT=3
# [console]
WELCOME_COINS=500
REFERRER_COINS=1000
MAX_COIN_PCT=20
PARTNER_REWARD_RUPEES=100

# ============ Grievance officer (shown publicly; required by IT Rules 2021) ============
GRIEVANCE_OFFICER_NAME=Dr Gunjan
GRIEVANCE_OFFICER_DESIGNATION=Grievance Officer
GRIEVANCE_OFFICER_EMAIL=
GRIEVANCE_OFFICER_PHONE=
GRIEVANCE_ADDRESS=PhysioCare by Healthtropic, Patna, Bihar
GRIEVANCE_HOURS=Mon–Sat, 10 AM–6 PM
GRIEVANCE_ACK_HOURS=24
GRIEVANCE_RESOLVE_DAYS=15

# ============ Maintenance and app versions [console] ============
MAINTENANCE_ENABLED=false
MAINTENANCE_MESSAGE=
MIN_APP_VERSION_PATIENT=0.1.0
MIN_APP_VERSION_THERAPIST=0.1.0
MIN_APP_VERSION_PARTNER=0.1.0
MIN_APP_VERSION_SUPER_ADMIN=0.1.0

# missing = .env fills only settings not yet in the database; overwrite = .env replaces them on every seed.
SETTINGS_FROM_ENV=missing

# ============ Website [console] ============
# Contact details and social links shown on the website (Website › Site settings in the console).
SITE_NAME=PhysioCare by Healthtropic
SITE_TAGLINE=Verified physiotherapy at home in Patna
SITE_SUPPORT_PHONE=
SITE_WHATSAPP=
SITE_EMAIL=
SITE_ADDRESS=Patna, Bihar
SITE_HOURS=Every day, 7 AM–9 PM
SITE_FACEBOOK=
SITE_INSTAGRAM=
SITE_YOUTUBE=
SITE_LINKEDIN=
