# Copy to .env. Restart Expo after changing.
# Android emulator: http://10.0.2.2:4000 · real phone on the same Wi-Fi: http://<your PC's LAN IP>:4000
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
EXPO_PUBLIC_STATUS_CHECK_SECONDS=60
# How often the SOS / live screen refreshes (seconds).
EXPO_PUBLIC_LIVE_REFRESH_SECONDS=15
